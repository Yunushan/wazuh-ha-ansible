[Unit]
Description=Wazuh backend firewall
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=-/usr/sbin/nft delete table inet wazuh_backend
ExecStart=/usr/sbin/nft -f /etc/nftables.d/wazuh-backend-firewall.nft
ExecReload=/bin/sh -c '/usr/sbin/nft delete table inet wazuh_backend 2>/dev/null || true; /usr/sbin/nft -f /etc/nftables.d/wazuh-backend-firewall.nft'
ExecStop=-/usr/sbin/nft delete table inet wazuh_backend
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
