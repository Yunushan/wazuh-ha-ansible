global_defs {
    enable_script_security
    script_user root
}

vrrp_script chk_lb {
    script "/usr/local/sbin/wazuh-keepalived-check-lb"
    interval {{ wazuh_keepalived_check_interval | default(1) }}
    fall {{ wazuh_keepalived_check_fall | default(1) }}
    rise {{ wazuh_keepalived_check_rise | default(1) }}
}

vrrp_instance VI_WAZUH {
    state BACKUP
    interface {{ wazuh_keepalived_interface }}
    virtual_router_id {{ wazuh_keepalived_router_id }}
    priority {{ keepalived_priority | default(100) }}
    advert_int {{ wazuh_keepalived_advert_int | default(1) }}
    down_timer_adverts {{ wazuh_keepalived_down_timer_adverts | default(1) }}
{% if wazuh_keepalived_nopreempt | default(true) | bool %}
    nopreempt
{% elif (wazuh_keepalived_preempt_delay | default(0) | int) > 0 %}
    preempt_delay {{ wazuh_keepalived_preempt_delay | int }}
{% endif %}
    garp_master_delay {{ wazuh_keepalived_garp_master_delay | default(0) }}
    garp_master_repeat {{ wazuh_keepalived_garp_master_repeat | default(5) }}
    garp_master_refresh {{ wazuh_keepalived_garp_master_refresh | default(10) }}
    garp_master_refresh_repeat {{ wazuh_keepalived_garp_master_refresh_repeat | default(2) }}
{% if wazuh_keepalived_unicast_enabled | default(false) | bool %}
    unicast_src_ip {{ wazuh_keepalived_unicast_src_ip | default(wazuh_node_ip | default(ansible_host | default(inventory_hostname))) }}
    unicast_peer {
{% for host in groups.get('wazuh_loadbalancers', []) %}
{% if host != inventory_hostname %}
        {{ hostvars[host].wazuh_keepalived_unicast_src_ip | default(hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host))) }}
{% endif %}
{% endfor %}
    }
{% endif %}
    authentication {
        auth_type PASS
        auth_pass {{ wazuh_keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ wazuh_lb_virtual_ip }}
    }
    track_script {
        chk_lb
    }
}
