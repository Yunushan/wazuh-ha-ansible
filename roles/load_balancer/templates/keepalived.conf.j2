global_defs {
    enable_script_security
    script_user root
}

vrrp_script chk_lb {
    script "/usr/bin/pgrep -x {{ 'haproxy' if wazuh_load_balancer_engine == 'haproxy' else 'nginx' }}"
    interval 2
    fall 2
    rise 2
}

vrrp_instance VI_WAZUH {
    state BACKUP
    interface {{ wazuh_keepalived_interface }}
    virtual_router_id {{ wazuh_keepalived_router_id }}
    priority {{ keepalived_priority | default(100) }}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ wazuh_keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ wazuh_lb_virtual_ip }}
    }
    track_script {
        chk_lb
    }
}
