{% set lb_bind_address = wazuh_lb_bind_address | default('*', true) %}
{% set lb_listen_prefix = '' if lb_bind_address in ['*', '0.0.0.0'] else lb_bind_address ~ ':' %}
stream {
    upstream wazuh_agent_events {
        hash $remote_addr consistent;
{% set worker_hosts = [] %}
{% for host in groups.get('wazuh_managers', []) %}
{% if hostvars[host].wazuh_manager_type | default('worker') == 'worker' %}
{% set _ = worker_hosts.append(host) %}
{% endif %}
{% endfor %}
{% set event_hosts = worker_hosts if (wazuh_lb_1514_to_workers_only | default(true) | bool and worker_hosts | length > 0) else groups.get('wazuh_managers', []) %}
{% for host in event_hosts %}
        server {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:1514;
{% endfor %}
    }

    upstream wazuh_agent_enrollment {
{% for host in groups.get('wazuh_managers', []) %}
{% if hostvars[host].wazuh_manager_type | default('worker') == 'master' %}
        server {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:1515;
{% endif %}
{% endfor %}
    }

    upstream wazuh_api {
{% for host in groups.get('wazuh_managers', []) %}
        server {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:55000;
{% endfor %}
    }

    upstream wazuh_dashboard_https {
{% for host in groups.get('wazuh_dashboards', []) %}
        server {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:{{ wazuh_dashboard_port | default(443) }};
{% endfor %}
    }

{% if wazuh_lb_expose_indexer_api | default(false) | bool %}
    upstream wazuh_indexer_api {
{% for host in groups.get('wazuh_indexers', []) %}
        server {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:9200;
{% endfor %}
    }

{% endif %}
    server {
        listen {{ lb_listen_prefix }}{{ wazuh_lb_agent_events_frontend_port | default(1514) }};
        proxy_pass wazuh_agent_events;
    }

    server {
        listen {{ lb_listen_prefix }}{{ wazuh_lb_agent_enrollment_frontend_port | default(1515) }};
        proxy_pass wazuh_agent_enrollment;
    }

    server {
        listen {{ lb_listen_prefix }}{{ wazuh_lb_api_frontend_port | default(55000) }};
        proxy_pass wazuh_api;
    }

    server {
        listen {{ lb_listen_prefix }}{{ wazuh_lb_dashboard_frontend_port | default(443) }};
        proxy_pass wazuh_dashboard_https;
    }

{% if wazuh_lb_expose_indexer_api | default(false) | bool %}
    server {
        listen {{ lb_listen_prefix }}{{ wazuh_lb_indexer_api_frontend_port | default(9200) }};
        proxy_pass wazuh_indexer_api;
    }
{% endif %}
}
