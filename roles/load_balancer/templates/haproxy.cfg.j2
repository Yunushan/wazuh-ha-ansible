{% set lb_bind_address = wazuh_lb_effective_bind_address | default(wazuh_lb_bind_address | default('*', true)) %}
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn 10000

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect {{ wazuh_haproxy_timeout_connect | default('2s') }}
    timeout check {{ wazuh_haproxy_timeout_check | default('1s') }}
    timeout client  1h
    timeout server  1h
    default-server inter {{ wazuh_haproxy_check_inter | default('1s') }} fastinter {{ wazuh_haproxy_check_fastinter | default('500ms') }} fall {{ wazuh_haproxy_check_fall | default(2) }} rise {{ wazuh_haproxy_check_rise | default(2) }}

frontend wazuh_agent_events_1514
    bind {{ lb_bind_address }}:{{ wazuh_lb_effective_agent_events_frontend_port | default(wazuh_lb_agent_events_frontend_port | default(1514)) }}
    default_backend wazuh_agent_events

backend wazuh_agent_events
    balance source
{% set worker_hosts = [] %}
{% for host in groups.get('wazuh_managers', []) %}
{% if hostvars[host].wazuh_manager_type | default('worker') == 'worker' %}
{% set _ = worker_hosts.append(host) %}
{% endif %}
{% endfor %}
{% set prefer_workers = wazuh_lb_1514_to_workers_only | default(true) | bool and worker_hosts | length > 0 %}
{% for host in groups.get('wazuh_managers', []) %}
{% set is_worker = hostvars[host].wazuh_manager_type | default('worker') == 'worker' %}
{% if (not prefer_workers) or is_worker %}
    server {{ hostvars[host].wazuh_manager_name | default(host) }} {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:1514 check
{% elif wazuh_lb_1514_master_backup | default(true) | bool %}
    server {{ hostvars[host].wazuh_manager_name | default(host) }} {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:1514 check backup
{% endif %}
{% endfor %}

frontend wazuh_agent_enrollment_1515
    bind {{ lb_bind_address }}:{{ wazuh_lb_effective_agent_enrollment_frontend_port | default(wazuh_lb_agent_enrollment_frontend_port | default(1515)) }}
    default_backend wazuh_agent_enrollment

backend wazuh_agent_enrollment
    balance first
{% for host in groups.get('wazuh_managers', []) %}
{% if hostvars[host].wazuh_manager_type | default('worker') == 'master' %}
    server {{ hostvars[host].wazuh_manager_name | default(host) }} {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:1515 check
{% endif %}
{% endfor %}

frontend wazuh_api_55000
    bind {{ lb_bind_address }}:{{ wazuh_lb_effective_api_frontend_port | default(wazuh_lb_api_frontend_port | default(55000)) }}
    default_backend wazuh_api

backend wazuh_api
    balance first
{% for host in groups.get('wazuh_managers', []) %}
    server {{ hostvars[host].wazuh_manager_name | default(host) }} {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:55000 check
{% endfor %}

frontend wazuh_dashboard_https
    bind {{ lb_bind_address }}:{{ wazuh_lb_effective_dashboard_frontend_port | default(wazuh_lb_dashboard_frontend_port | default(443)) }}
    default_backend wazuh_dashboard_https

backend wazuh_dashboard_https
    balance roundrobin
{% for host in groups.get('wazuh_dashboards', []) %}
    server {{ hostvars[host].wazuh_dashboard_name | default(host) }} {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:{{ wazuh_dashboard_port | default(443) }} check
{% endfor %}

{% if wazuh_lb_expose_indexer_api | default(false) | bool %}
frontend wazuh_indexer_api_9200
    bind {{ lb_bind_address }}:{{ wazuh_lb_effective_indexer_api_frontend_port | default(wazuh_lb_indexer_api_frontend_port | default(9200)) }}
    default_backend wazuh_indexer_api

backend wazuh_indexer_api
    balance roundrobin
{% for host in groups.get('wazuh_indexers', []) %}
    server {{ hostvars[host].wazuh_indexer_name | default(host) }} {{ hostvars[host].wazuh_node_ip | default(hostvars[host].ansible_host | default(host)) }}:9200 check
{% endfor %}
{% endif %}
